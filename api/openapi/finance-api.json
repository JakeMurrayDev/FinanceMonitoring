{
  "openapi": "3.2.0",
  "info": {
    "title": "FinanceMonitoring.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/budgets/{categoryId}": {
      "delete": {
        "tags": [
          "Budgets"
        ],
        "summary": "Clear a category's budget from a month onward. Returns the updated line.",
        "operationId": "ClearBudget",
        "parameters": [
          {
            "name": "categoryId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "month",
            "in": "query",
            "required": true,
            "schema": {
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
              "type": "string"
            }
          },
          {
            "name": "version",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetBudgetsBudgetLine"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Budgets"
        ],
        "summary": "Set a category's monthly budget from a month onward.",
        "operationId": "SetBudget",
        "parameters": [
          {
            "name": "categoryId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetBudgetRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetBudgetsBudgetLine"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/budgets": {
      "get": {
        "tags": [
          "Budgets"
        ],
        "summary": "Budgets, spending and status for every expense category in a month.",
        "operationId": "GetBudgets",
        "parameters": [
          {
            "name": "month",
            "in": "query",
            "schema": {
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetBudgetsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/categories": {
      "get": {
        "tags": [
          "Categories"
        ],
        "summary": "List transaction categories, optionally filtered by type.",
        "operationId": "ListCategories",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/TransactionType"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListCategoriesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/dashboard": {
      "get": {
        "tags": [
          "Dashboard"
        ],
        "summary": "Monthly totals, spending by category and a six-month trend, in any supported currency.",
        "operationId": "GetDashboard",
        "parameters": [
          {
            "name": "month",
            "in": "query",
            "schema": {
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
              "type": "string"
            }
          },
          {
            "name": "currency",
            "in": "query",
            "schema": {
              "pattern": "^[A-Z]{3}$",
              "type": "string",
              "default": "USD"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDashboardResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/rates/{currency}": {
      "get": {
        "tags": [
          "Rates"
        ],
        "summary": "The latest USD rate for a display currency.",
        "operationId": "GetRate",
        "parameters": [
          {
            "name": "currency",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RateInfo"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/currencies": {
      "get": {
        "tags": [
          "Rates"
        ],
        "summary": "Currencies amounts can be displayed in.",
        "operationId": "ListCurrencies",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListCurrenciesResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/transactions": {
      "post": {
        "tags": [
          "Transactions"
        ],
        "summary": "Record a new transaction.",
        "operationId": "CreateTransaction",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTransactionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Transactions"
        ],
        "summary": "Search, filter, sort and page through transactions.",
        "operationId": "ListTransactions",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "schema": {
              "maxLength": 100,
              "minLength": 0,
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/TransactionType"
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "default": "Date",
              "$ref": "#/components/schemas/ListTransactionsSortField"
            }
          },
          {
            "name": "dir",
            "in": "query",
            "schema": {
              "default": "Desc",
              "$ref": "#/components/schemas/SortDirection"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "maximum": 2147483647,
              "minimum": 1,
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
              "format": "int32",
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedResponseOfTransactionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/transactions/{id}": {
      "delete": {
        "tags": [
          "Transactions"
        ],
        "summary": "Delete a transaction. Requires the current version.",
        "operationId": "DeleteTransaction",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "version",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Transactions"
        ],
        "summary": "Get one transaction.",
        "operationId": "GetTransaction",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Transactions"
        ],
        "summary": "Replace a transaction. Requires the current version.",
        "operationId": "UpdateTransaction",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTransactionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BudgetStatus": {
        "enum": [
          "NoBudget",
          "OnTrack",
          "NearLimit",
          "OverBudget"
        ]
      },
      "CreateTransactionRequest": {
        "required": [
          "date",
          "description",
          "amount",
          "currency",
          "type",
          "categoryId"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "Calendar date (yyyy-MM-dd). Not in the future.",
            "format": "date"
          },
          "description": {
            "maxLength": 200,
            "minLength": 0,
            "type": "string",
            "description": "Payee or note, 1–200 characters."
          },
          "amount": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer",
            "description": "Positive integer minor units (cents). Never a decimal.",
            "format": "int64"
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 code. Only USD is supported for now."
          },
          "type": {
            "description": "Income or Expense.",
            "$ref": "#/components/schemas/TransactionType"
          },
          "categoryId": {
            "maxLength": 32,
            "minLength": 0,
            "type": "string",
            "description": "A category whose type matches Type."
          }
        }
      },
      "GetBudgetsBudgetLine": {
        "required": [
          "categoryId",
          "categoryName",
          "budget",
          "budgetEffectiveFrom",
          "spent",
          "remaining",
          "percentUsed",
          "status",
          "version"
        ],
        "type": "object",
        "properties": {
          "categoryId": {
            "type": "string",
            "description": "Expense category slug."
          },
          "categoryName": {
            "type": "string",
            "description": "Display name."
          },
          "budget": {
            "type": [
              "null",
              "integer"
            ],
            "description": "Limit for this month in minor units, or null if none applies.",
            "format": "int64"
          },
          "budgetEffectiveFrom": {
            "type": [
              "null",
              "string"
            ],
            "description": "The month (yyyy-MM) the applicable budget row started; null if there has never been one."
          },
          "spent": {
            "type": "integer",
            "description": "Expenses in this category this month, in minor units.",
            "format": "int64"
          },
          "remaining": {
            "type": [
              "null",
              "integer"
            ],
            "description": "Budget minus spent (negative when over), or null with no budget.",
            "format": "int64"
          },
          "percentUsed": {
            "type": [
              "null",
              "integer"
            ],
            "description": "Whole percent of the budget spent, rounded down; null with no budget.",
            "format": "int32"
          },
          "status": {
            "description": "How spending compares with the budget.",
            "$ref": "#/components/schemas/BudgetStatus"
          },
          "version": {
            "type": [
              "null",
              "integer"
            ],
            "description": "Version of the row that starts this month, if any. Send it when changing this month's budget; null means the budget is inherited.",
            "format": "int64"
          }
        }
      },
      "GetBudgetsBudgetTotals": {
        "required": [
          "budgeted",
          "spentInBudgeted",
          "remaining",
          "unbudgeted",
          "overBudgetCount"
        ],
        "type": "object",
        "properties": {
          "budgeted": {
            "type": "integer",
            "description": "Sum of all budgets this month.",
            "format": "int64"
          },
          "spentInBudgeted": {
            "type": "integer",
            "description": "Spending in categories that have a budget.",
            "format": "int64"
          },
          "remaining": {
            "type": "integer",
            "description": "Budgeted minus spent in budgeted categories.",
            "format": "int64"
          },
          "unbudgeted": {
            "type": "integer",
            "description": "Spending in categories with no budget.",
            "format": "int64"
          },
          "overBudgetCount": {
            "type": "integer",
            "description": "Number of categories over budget.",
            "format": "int32"
          }
        }
      },
      "GetBudgetsResponse": {
        "required": [
          "month",
          "currency",
          "lines",
          "totals"
        ],
        "type": "object",
        "properties": {
          "month": {
            "type": "string",
            "description": "The month reported on (yyyy-MM)."
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 code of every amount."
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetBudgetsBudgetLine"
            },
            "description": "One line per expense category, by name."
          },
          "totals": {
            "description": "Month totals.",
            "$ref": "#/components/schemas/GetBudgetsBudgetTotals"
          }
        }
      },
      "GetDashboardCategorySpend": {
        "required": [
          "categoryId",
          "name",
          "amount"
        ],
        "type": "object",
        "properties": {
          "categoryId": {
            "type": "string",
            "description": "Category slug."
          },
          "name": {
            "type": "string",
            "description": "Display name."
          },
          "amount": {
            "type": "integer",
            "description": "Expenses this month, in minor units of the response currency.",
            "format": "int64"
          }
        }
      },
      "GetDashboardMonthTotals": {
        "required": [
          "income",
          "expenses",
          "net"
        ],
        "type": "object",
        "properties": {
          "income": {
            "type": "integer",
            "description": "Income, in minor units of the response currency.",
            "format": "int64"
          },
          "expenses": {
            "type": "integer",
            "description": "Expenses, in minor units of the response currency.",
            "format": "int64"
          },
          "net": {
            "type": "integer",
            "description": "Income minus expenses (converted from the exact USD net, not from the converted parts).",
            "format": "int64"
          }
        }
      },
      "GetDashboardResponse": {
        "required": [
          "month",
          "currency",
          "rate",
          "totals",
          "previous",
          "savingsRateBasisPoints",
          "byCategory",
          "trend"
        ],
        "type": "object",
        "properties": {
          "month": {
            "type": "string",
            "description": "The month summarised (yyyy-MM)."
          },
          "currency": {
            "type": "string",
            "description": "Currency of every amount in this response."
          },
          "rate": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "The rate used, or null when no conversion was needed (USD).",
                "$ref": "#/components/schemas/RateInfo"
              }
            ]
          },
          "totals": {
            "description": "This month's income, expenses and net.",
            "$ref": "#/components/schemas/GetDashboardMonthTotals"
          },
          "previous": {
            "description": "The previous month's totals, for comparison.",
            "$ref": "#/components/schemas/GetDashboardMonthTotals"
          },
          "savingsRateBasisPoints": {
            "type": [
              "null",
              "integer"
            ],
            "description": "Net as a share of income in basis points (2345 = 23.45%); null with no income. Currency-independent.",
            "format": "int32"
          },
          "byCategory": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetDashboardCategorySpend"
            },
            "description": "This month's expenses per category, largest first."
          },
          "trend": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetDashboardTrendPoint"
            },
            "description": "Income, expenses and net for the six months ending this month, oldest first. Months with no activity are zero."
          }
        }
      },
      "GetDashboardTrendPoint": {
        "required": [
          "month",
          "income",
          "expenses",
          "net"
        ],
        "type": "object",
        "properties": {
          "month": {
            "type": "string",
            "description": "yyyy-MM."
          },
          "income": {
            "type": "integer",
            "description": "Minor units.",
            "format": "int64"
          },
          "expenses": {
            "type": "integer",
            "description": "Minor units.",
            "format": "int64"
          },
          "net": {
            "type": "integer",
            "description": "Minor units.",
            "format": "int64"
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
