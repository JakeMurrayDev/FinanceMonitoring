{
  "openapi": "3.2.0",
  "info": {
    "title": "FinanceMonitoring.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/categories": {
      "get": {
        "tags": [
          "Categories"
        ],
        "summary": "List transaction categories, optionally filtered by type.",
        "operationId": "ListCategories",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/TransactionType"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListCategoriesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/transactions": {
      "post": {
        "tags": [
          "Transactions"
        ],
        "summary": "Record a new transaction.",
        "operationId": "CreateTransaction",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTransactionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Transactions"
        ],
        "summary": "Search, filter, sort and page through transactions.",
        "operationId": "ListTransactions",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "schema": {
              "maxLength": 100,
              "minLength": 0,
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/TransactionType"
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "default": "Date",
              "$ref": "#/components/schemas/ListTransactionsSortField"
            }
          },
          {
            "name": "dir",
            "in": "query",
            "schema": {
              "default": "Desc",
              "$ref": "#/components/schemas/SortDirection"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "maximum": 2147483647,
              "minimum": 1,
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
              "format": "int32",
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedResponseOfTransactionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/transactions/{id}": {
      "delete": {
        "tags": [
          "Transactions"
        ],
        "summary": "Delete a transaction. Requires the current version.",
        "operationId": "DeleteTransaction",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "version",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Transactions"
        ],
        "summary": "Get one transaction.",
        "operationId": "GetTransaction",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Transactions"
        ],
        "summary": "Replace a transaction. Requires the current version.",
        "operationId": "UpdateTransaction",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTransactionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateTransactionRequest": {
        "required": [
          "date",
          "description",
          "amount",
          "currency",
          "type",
          "categoryId"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "Calendar date (yyyy-MM-dd). Not in the future.",
            "format": "date"
          },
          "description": {
            "maxLength": 200,
            "minLength": 0,
            "type": "string",
            "description": "Payee or note, 1–200 characters."
          },
          "amount": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer",
            "description": "Positive integer minor units (cents). Never a decimal.",
            "format": "int64"
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 code. Only USD is supported for now."
          },
          "type": {
            "description": "Income or Expense.",
            "$ref": "#/components/schemas/TransactionType"
          },
          "categoryId": {
            "maxLength": 32,
            "minLength": 0,
            "type": "string",
            "description": "A category whose type matches Type."
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "ListCategoriesCategoryItem": {
        "required": [
          "id",
          "name",
          "type"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/TransactionType"
          }
        }
      },
      "ListCategoriesResponse": {
        "required": [
          "categories"
        ],
        "type": "object",
        "properties": {
          "categories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ListCategoriesCategoryItem"
            }
          }
        }
      },
      "ListTransactionsSortField": {
        "enum": [
          "Date",
          "Amount",
          "Description",
          "Category"
        ]
      },
      "PagedResponseOfTransactionResponse": {
        "required": [
          "items",
          "page",
          "pageSize",
          "totalCount",
          "totalPages"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransactionResponse"
            },
            "description": "The rows on this page."
          },
          "page": {
            "type": "integer",
            "description": "1-based page number.",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "description": "Requested rows per page.",
            "format": "int32"
          },
          "totalCount": {
            "type": "integer",
            "description": "Rows matching the filters, across all pages.",
            "format": "int32"
          },
          "totalPages": {
            "type": "integer",
            "description": "Number of pages at this page size (0 when nothing matches).",
            "format": "int32"
          }
        },
        "description": "Standard envelope for any paginated list endpoint."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SortDirection": {
        "enum": [
          "Asc",
          "Desc"
        ]
      },
      "TransactionResponse": {
        "required": [
          "id",
          "date",
          "description",
          "amount",
          "currency",
          "type",
          "categoryId",
          "categoryName",
          "version"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique, time-ordered identifier.",
            "format": "uuid"
          },
          "date": {
            "type": "string",
            "description": "Calendar date of the transaction (yyyy-MM-dd).",
            "format": "date"
          },
          "description": {
            "type": "string",
            "description": "Payee or note."
          },
          "amount": {
            "type": "integer",
            "description": "Positive integer minor units (cents). Direction is given by Type.",
            "format": "int64"
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 code of Amount."
          },
          "type": {
            "description": "Income or Expense.",
            "$ref": "#/components/schemas/TransactionType"
          },
          "categoryId": {
            "type": "string",
            "description": "Category slug, usable in the `category` filter."
          },
          "categoryName": {
            "type": "string",
            "description": "Display name of the category."
          },
          "version": {
            "type": "integer",
            "description": "Concurrency token. Send it back when updating or deleting.",
            "format": "int64"
          }
        },
        "description": "A transaction as returned by every transactions endpoint."
      },
      "TransactionType": {
        "enum": [
          "Income",
          "Expense"
        ]
      },
      "UpdateTransactionRequest": {
        "required": [
          "date",
          "description",
          "amount",
          "currency",
          "type",
          "categoryId",
          "version"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "Calendar date (yyyy-MM-dd). Not in the future.",
            "format": "date"
          },
          "description": {
            "maxLength": 200,
            "minLength": 0,
            "type": "string",
            "description": "Payee or note, 1–200 characters."
          },
          "amount": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer",
            "description": "Positive integer minor units (cents). Never a decimal.",
            "format": "int64"
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 code. Only USD is supported for now."
          },
          "type": {
            "description": "Income or Expense.",
            "$ref": "#/components/schemas/TransactionType"
          },
          "categoryId": {
            "maxLength": 32,
            "minLength": 0,
            "type": "string",
            "description": "A category whose type matches Type."
          },
          "version": {
            "maximum": 9223372036854776000,
            "minimum": 1,
            "type": "integer",
            "description": "The version you last read. A mismatch means someone else changed it: 409.",
            "format": "int64"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Categories"
    },
    {
      "name": "Transactions"
    }
  ]
}